    "jwks-rsa": "^3.1.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "mime-types": "^2.1.35",
    "nestjs-form-data": "^1.9.93",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfreader": "^3.0.7",
    "pg": "^8.16.3",
    "puppeteer": "^24.9.0",
    "redis": "^4.7.0",
