{
  "name": "karate-app",
  "description": "Karate App",
  "private": true,
  "version": "4.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "yarn exec scripts/execute.sh local-setup",
    "build": "yarn exec scripts/execute.sh build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "docs": "yarn exec scripts/execute.sh docs",
    "openapi:build": "nest start --config src/common/http/openapi/openapi.tsc.nest-cli.json",
    "openapi:lint": "yarn openapi-codegen check --input http://localhost:3002/docs-json",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "migration:generate": "yarn typeorm migration:generate -d src/database/data-source.ts src/database/migrations/migration",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run -d src/database/data-source.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "yarn typeorm migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/cloudfront-signer": "^3.734.0",
    "@aws-sdk/s3-presigned-post": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@linear/sdk": "^60.0.0",
