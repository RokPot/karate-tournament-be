{
  "include": [
    "src/**/*.ts"
  ],
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.unit.ts",
    "**/*.fixture.ts",
    "**/*.mock.ts",
    "**/*.e2e.ts",
    "**/.*.scaffold.ts",
    "**/.scaffold.ts",
    "**/.scaffold/*",
    "packages"
  ]
}
